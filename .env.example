# ─────────────────────────────────────────────────────────────────────────────
# Phase 0 environment. Copy to .env.local and fill in. NEVER commit .env.local.
# PRD 17.1: separate production/staging credentials; least-privilege service accounts.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=development                       # development | staging | production

# Owner connection — runs migrations only. Bypasses RLS by owning the tables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/leadcalling

# Runtime connection — non-owner role, RLS is ENFORCED. The app must use this.
DATABASE_URL_APP=postgresql://app_user:app_user_dev_pw@localhost:5434/leadcalling

# Service/worker connection for n8n and background workers (PRD 4: "service identity only").
DATABASE_URL_SERVICE=postgresql://app_service:app_service_dev_pw@localhost:5434/leadcalling

# ── Secrets management (PRD 17.1) ────────────────────────────────────────────
# 32-byte base64 master key. Wraps per-secret data keys (envelope encryption).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_MASTER_KEY=
KMS_MASTER_KEY_ID=local-dev-1
# Previous keys for rotation, as JSON: {"local-dev-0":"<base64>"}
KMS_PREVIOUS_KEYS={}

# ── PII protection (PRD 26.2) ────────────────────────────────────────────────
# Separate key for column-level PII encryption. Must differ from KMS_MASTER_KEY.
PII_ENCRYPTION_KEY=
# HMAC key for blind indexes (deterministic lookup over encrypted phone/email).
PII_BLIND_INDEX_KEY=

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ── AI qualification (PRD 10, FR-031) ────────────────────────────────────────
# Used by the transcript analysis in src/lib/qualification/analyze.ts.
#
# Optional by design: with no credentials the analysis degrades to an
# `unknown` result at confidence 0, which always trips the review gate, so a
# client's CRM never receives a result the platform could not produce
# (PRD 18.2 "LLM schema failure -> fallback to manual review"). But nothing is
# ever auto-qualified either, so set this to see real intents and scores.
#
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Required only for an identity-linked API key, which is scoped to a person
# rather than to a workspace and so cannot infer which workspace a request
# acts in. Leave blank for an ordinary workspace key. Without it, such a key
# fails every request with "anthropic-workspace-id is required" and every
# analysis degrades to review - which looks exactly like having no key at all.
ANTHROPIC_WORKSPACE_ID=

# Gemini is the second registered analysis provider. Which one runs is decided
# per campaign by `campaigns.analysis_model`: a `claude-*` id resolves to
# Anthropic, a `gemini-*` id to Google. This key is what registers the Gemini
# adapter at all - without it, a campaign set to a Gemini model holds its leads
# for review with a message naming the providers that are registered, rather
# than failing somewhere less legible inside the SDK.
#
# GOOGLE_API_KEY works too; the SDK reads either.
GEMINI_API_KEY=

# ── Voice provider ───────────────────────────────────────────────────────────
# Shared secret for provider callbacks. The mock provider signs its webhook
# body with it; the Sarvam adapter uses it to key the per-call token it sends
# through webhook metadata (Sarvam does not sign callbacks).
VOICE_WEBHOOK_SECRET=dev-webhook-secret

# Twilio, for local testing against a real phone. Telephony only - the
# conversation is TwiML this platform serves, so no AI vendor is involved.
# Registers when all three are set. Requires a public APP_URL: Twilio fetches
# the TwiML and posts status callbacks, so localhost will not do.
#
# On a trial account, outbound calls only reach numbers verified in the Twilio
# console - put those in the campaign's Dial allowlist.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Sarvam AI voice agents (PRD 10.4, and the India-capable provider PRD 17.3
# points at). The adapter registers only when all six are set; a campaign can
# then select "sarvam" instead of "mock".
#
# From the Sarvam console: the org and workspace the agent lives in, the agent
# ("app") that runs the conversation, and the telephony connection plus the
# number calls originate from.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

# ── Scheduling ───────────────────────────────────────────────────────────────
# Shared secret for the scheduled sweep at /api/cron/tick, which places calls
# whose retry or callback has come due and drains the sync outbox. Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET` automatically.
#
# The endpoint returns 503 rather than running open when this is unset, and
# env() refuses to boot without it outside development - on a serverless
# platform nothing else dials a lead whose retry fell due.
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Per-pool connection ceiling. Serverless multiplies pools - every warm
# instance holds its own - so keep this small in production and point the
# DATABASE_URL_* values at a pooled connection string (Neon's `-pooler` host,
# Supabase's port 6543). Defaults to 10 in development, 3 elsewhere.
DB_POOL_MAX=

# ── App ──────────────────────────────────────────────────────────────────────
# In production this is the deployed origin, and it must be stable: the calling
# worker mints provider callback URLs from it and Twilio's signature check
# compares against it.
APP_URL=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# One JSON object per line on stdout (warn and error on stderr), which is what
# every host already collects. Values pass through a redactor first, so a lead's
# phone number or a credential cannot reach a log drain by being included in a
# field somebody added.
#
# Threshold: debug | info | warn | error. Defaults to info, which drops debug
# and keeps everything else.
LOG_LEVEL=

# Include stack traces on logged errors. Off by default: a stack is the bulkiest
# part of a line and routinely contains interpolated argument values from frames
# above the throw, which is how an argument nobody meant to log gets logged.
# Turn it on while debugging, not in steady state.
LOG_STACKS=
