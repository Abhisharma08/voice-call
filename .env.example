# ─────────────────────────────────────────────────────────────────────────────
# Phase 0 environment. Copy to .env.local and fill in. NEVER commit .env.local.
# PRD 17.1: separate production/staging credentials; least-privilege service accounts.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=development                       # development | staging | production

# Owner connection — runs migrations only. Bypasses RLS by owning the tables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/leadcalling

# Runtime connection — non-owner role, RLS is ENFORCED. The app must use this.
DATABASE_URL_APP=postgresql://app_user:app_user_dev_pw@localhost:5434/leadcalling

# Service/worker connection for n8n and background workers (PRD 4: "service identity only").
DATABASE_URL_SERVICE=postgresql://app_service:app_service_dev_pw@localhost:5434/leadcalling

# ── Secrets management (PRD 17.1) ────────────────────────────────────────────
# 32-byte base64 master key. Wraps per-secret data keys (envelope encryption).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KMS_MASTER_KEY=
KMS_MASTER_KEY_ID=local-dev-1
# Previous keys for rotation, as JSON: {"local-dev-0":"<base64>"}
KMS_PREVIOUS_KEYS={}

# ── PII protection (PRD 26.2) ────────────────────────────────────────────────
# Separate key for column-level PII encryption. Must differ from KMS_MASTER_KEY.
PII_ENCRYPTION_KEY=
# HMAC key for blind indexes (deterministic lookup over encrypted phone/email).
PII_BLIND_INDEX_KEY=

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ── AI qualification (PRD 10, FR-031) ────────────────────────────────────────
# Used by the transcript analysis in src/lib/qualification/analyze.ts.
#
# Optional by design: with no credentials the analysis degrades to an
# `unknown` result at confidence 0, which always trips the review gate, so a
# client's CRM never receives a result the platform could not produce
# (PRD 18.2 "LLM schema failure -> fallback to manual review"). But nothing is
# ever auto-qualified either, so set this to see real intents and scores.
#
# The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
